#!/usr/bin/env bash
# hued — manage terminal colors per directory

set -euo pipefail

HUED_VERSION="3.6.0"

_HUED_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Locate hued-names.sh across install layouts: repo root / manual install
# (alongside _HUED_DIR) and Homebrew (bin in <prefix>/bin, names in
# <prefix>/share).
_HUED_NAMES_FILE="$_HUED_DIR/hued-names.sh"
[[ -f "$_HUED_NAMES_FILE" ]] || _HUED_NAMES_FILE="$_HUED_DIR/share/hued-names.sh"

_hued_find() {
  local dir="$PWD"
  while [[ "$dir" != / && -n "$dir" ]]; do
    [[ -f "$dir/.hued" ]] && echo "$dir/.hued" && return 0
    dir="${dir%/*}"
  done
  return 1
}

# Lowercase and strip spaces, hyphens and apostrophes, matching the key
# normalization in scripts/generate-names.py.
_hued_name_key() {
  local k="$1"
  k="${k// /}"; k="${k//-/}"; k="${k//\'/}"; k="${k//’/}"
  printf '%s' "${k,,}"
}

# Look up a normalized name key in hued-names.sh, printing #rrggbb or nothing.
# Keys outside the generated alphabet are rejected before the grep so a name
# containing a regex metacharacter cannot match some unrelated row.
_hued_lookup_name() {
  local key="$1" hex=""
  [[ "$key" =~ ^[a-z0-9/]+$ ]] || return 0
  [[ -f "$_HUED_NAMES_FILE" ]] || return 0
  if [[ "${_HUED_XKCD:-0}" == "1" ]]; then
    hex=$({ grep -m1 "\[xkcd:${key}\]=" "$_HUED_NAMES_FILE" 2>/dev/null || true; } | cut -d= -f2)
  fi
  [[ -n "$hex" ]] || hex=$({ grep -m1 "\[${key}\]=" "$_HUED_NAMES_FILE" 2>/dev/null || true; } | cut -d= -f2)
  printf '%s' "$hex"
}

_hued_normalize_color() {
  local bare="${1#\#}"

  # Expand 3-char shorthand to 6-char
  if [[ "$bare" =~ ^[0-9a-fA-F]{3}$ ]]; then
    bare="${bare:0:1}${bare:0:1}${bare:1:1}${bare:1:1}${bare:2:1}${bare:2:1}"
  fi

  # 6-char hex — normalize to lowercase #rrggbb
  if [[ "$bare" =~ ^[0-9a-fA-F]{6}$ ]]; then
    printf '#%s' "${bare,,}"
    return
  fi

  # Named color — resolve via hued-names.sh
  local hex
  hex=$(_hued_lookup_name "$(_hued_name_key "$bare")")
  [[ -n "$hex" ]] && printf '%s' "$hex" && return

  printf '%s' "$1"
}

# Print a pastel fraction for an amount ("20", "20%", "+20%", "-20%").
# Prints its own error and returns 1 on failure.
_hued_amount() {
  local val="$1" n sign mag
  if [[ "$val" =~ ^([+-]?[0-9]+(\.[0-9]+)?)%$ ]]; then
    n="${BASH_REMATCH[1]}"
  elif [[ "$val" =~ ^([+-]?[0-9]+(\.[0-9]+)?)$ ]]; then
    n="${BASH_REMATCH[1]}"
    sign=""; mag="$n"
    if [[ "$mag" == [+-]* ]]; then sign="${mag:0:1}"; mag="${mag:1}"; fi
    if awk -v a="$mag" 'BEGIN{exit !(a>0 && a<1)}'; then
      echo "hued mod: $val is ambiguous — write \"$val%\" for $val percent, or \"${sign}$(awk -v a="$mag" 'BEGIN{printf "%g", a*100}')%\"" >&2
      return 1
    fi
  else
    echo "hued mod: '$val' is not a number" >&2
    return 1
  fi
  awk -v n="$n" 'BEGIN{printf "%g", n/100}'
}

# Prints its own error and returns 1 on failure.
_hued_degrees() {
  local val="${1%deg}"
  val="${val%°}"
  if [[ ! "$val" =~ ^[+-]?[0-9]+(\.[0-9]+)?$ ]]; then
    echo "hued mod: '$1' is not a number of degrees" >&2
    return 1
  fi
  printf '%s' "$val"
}

_HUED_OPS="darken lighten saturate desaturate rotate complement to-gray mix lightness saturation hue"

_hued_is_op() { [[ -n "$1" && " $_HUED_OPS " == *" $1 "* ]]; }

_hued_invert() {
  case "$1" in
    darken)     printf 'lighten' ;;
    lighten)    printf 'darken' ;;
    saturate)   printf 'desaturate' ;;
    desaturate) printf 'saturate' ;;
  esac
}

_hued_pastel() { pastel "$@" | pastel format hex; }

# Apply a chain of ops to a color, printing the resulting hex.
# Usage: _hued_mod_run <color> <op> [args...] [<op> [args...]]...
_hued_mod_run() {
  local color="$1"; shift
  local op raw amount deg other verb prop

  while [[ $# -gt 0 ]]; do
    op="$1"; shift
    case "$op" in
      darken|lighten|saturate|desaturate)
        [[ $# -gt 0 ]] || { echo "hued mod: $op requires an amount" >&2; return 1; }
        raw="$1"; shift
        amount=$(_hued_amount "$raw") || return 1
        if [[ "$amount" == -* ]]; then
          op=$(_hued_invert "$op")
          amount="${amount#-}"
        fi
        color=$(_hued_pastel "$op" "$amount" "$color") || return 1
        ;;
      rotate)
        [[ $# -gt 0 ]] || { echo "hued mod: rotate requires degrees" >&2; return 1; }
        raw="$1"; shift
        deg=$(_hued_degrees "$raw") || return 1
        # -- keeps a negative angle from being read as a pastel flag
        color=$(_hued_pastel rotate -- "$deg" "$color") || return 1
        ;;
      complement|to-gray)
        color=$(_hued_pastel "$op" "$color") || return 1
        ;;
      mix)
        [[ $# -gt 0 ]] || { echo "hued mod: mix requires a color" >&2; return 1; }
        other="$1"; shift
        amount="0.5"
        if [[ $# -gt 0 ]] && ! _hued_is_op "$1"; then
          raw="$1"; shift
          amount=$(_hued_amount "$raw") || return 1
          if [[ "$amount" == -* ]]; then
            echo "hued mod: mix ratio cannot be negative" >&2
            return 1
          fi
        fi
        color=$(_hued_pastel mix --fraction "$amount" "$other" "$color") || return 1
        ;;
      lightness|saturation)
        [[ $# -gt 0 ]] || { echo "hued mod: $op requires a value" >&2; return 1; }
        raw="$1"; shift
        amount=$(_hued_amount "$raw") || return 1
        if [[ "$raw" == [+-]* ]]; then
          if [[ "$op" == "lightness" ]]; then verb="lighten"; else verb="saturate"; fi
          if [[ "$amount" == -* ]]; then
            verb=$(_hued_invert "$verb")
            amount="${amount#-}"
          fi
          color=$(_hued_pastel "$verb" "$amount" "$color") || return 1
        else
          if [[ "$op" == "lightness" ]]; then prop="hsl-lightness"; else prop="hsl-saturation"; fi
          color=$(_hued_pastel set "$prop" "$amount" "$color") || return 1
        fi
        ;;
      hue)
        [[ $# -gt 0 ]] || { echo "hued mod: hue requires degrees" >&2; return 1; }
        raw="$1"; shift
        deg=$(_hued_degrees "$raw") || return 1
        if [[ "$raw" == [+-]* ]]; then
          color=$(_hued_pastel rotate -- "$deg" "$color") || return 1
        else
          color=$(_hued_pastel set hsl-hue "$deg" "$color") || return 1
        fi
        ;;
      *)
        echo "hued mod: unknown op '$op' (${_HUED_OPS// /, })" >&2
        return 1
        ;;
    esac
  done

  printf '%s' "$color"
}

_hued_read_stdin_color() {
  [[ -t 0 ]] && return 1
  local line
  IFS= read -r line || return 1
  line="${line//[[:space:]]/}"
  [[ -z "$line" ]] && return 1
  printf '%s' "$line"
}

# The keys `.hued` understands. Color keys hold a color; policy keys hold a
# minting range and text keys a bare token, both for external tools.
_HUED_KEY_LIST="bg|fg|accent|accent2|accent3|branch-hue|branch-lightness|branch-chroma|sfkey"

# Canonicalize a key argument, or return 1 if it is not one of ours.
_hued_key() {
  case "${1:-}" in
    bg|background) printf 'background' ;;
    fg|foreground) printf 'foreground' ;;
    accent|accent2|accent3) printf '%s' "$1" ;;
    branch-hue|branch-lightness|branch-chroma|sfkey) printf '%s' "$1" ;;
    *) return 1 ;;
  esac
}

_hued_is_policy_key() { [[ "$1" == branch-* ]]; }
_hued_is_text_key() { [[ "$1" == sfkey ]]; }

# Validate one endpoint of a policy range, printing "<canonical>|<signed>".
# Prints its own error and returns 1 on failure.
_hued_policy_endpoint() {
  local cmd="$1" key="$2" raw="$3" unit num
  if [[ "$key" == "branch-hue" ]]; then
    unit="deg"; num="${raw%deg}"; num="${num%°}"
  else
    unit="%"; num="${raw%\%}"
  fi
  if [[ ! "$num" =~ ^([+-]?)([0-9]+(\.[0-9]+)?)$ ]]; then
    echo "$cmd: '$raw' is not a valid $key value (expected e.g. 30$unit or +30$unit)" >&2
    return 1
  fi
  local sign="${BASH_REMATCH[1]}" mag="${BASH_REMATCH[2]}"
  # Same ambiguity rule as `hued mod`: a bare 0.22 could mean either.
  if [[ "$unit" == "%" && "$num" == "$raw" ]] \
     && awk -v a="$mag" 'BEGIN{exit !(a>0 && a<1)}'; then
    echo "$cmd: $raw is ambiguous — write \"$raw%\" for $raw percent, or \"${sign}$(awk -v a="$mag" 'BEGIN{printf "%g", a*100}')%\"" >&2
    return 1
  fi
  printf '%s%s|%s' "$num" "$unit" "${sign:+1}"
}

# Validate a policy value ("A..B" or a lone "A"), printing its canonical form.
# Signed endpoints are relative to the repo's base color, unsigned absolute —
# so a range mixing the two has no meaning.
_hued_policy_value() {
  local cmd="$1" key="$2" raw="$3" lo_out hi_out
  if [[ "$raw" != *".."* ]]; then
    lo_out=$(_hued_policy_endpoint "$cmd" "$key" "$raw") || return 1
    printf '%s' "${lo_out%|*}"
    return 0
  fi
  lo_out=$(_hued_policy_endpoint "$cmd" "$key" "${raw%%..*}") || return 1
  hi_out=$(_hued_policy_endpoint "$cmd" "$key" "${raw#*..}") || return 1
  if [[ "${lo_out#*|}" != "${hi_out#*|}" ]]; then
    echo "$cmd: '$raw' mixes a signed endpoint with an absolute one — a $key range must be all signed (relative) or all unsigned (absolute)" >&2
    return 1
  fi
  printf '%s..%s' "${lo_out%|*}" "${hi_out%|*}"
}

# Replace (or append) one key's line in ./.hued, creating the file if needed.
# Print each key's line once, in first-seen order, with its last value: a key
# written twice (`hued pick >> .hued`) means the later line.
_hued_last_lines() {
  awk -v keys="^($2)=" '$0 ~ keys { k = substr($0, 1, index($0, "=") - 1)
    if (!(k in v)) o[n++] = k; v[k] = $0 }
    END { for (i = 0; i < n; i++) print v[o[i]] }' "$1"
}

_hued_put_line() {
  local key="$1" line="$2"
  if [[ -f .hued ]]; then
    grep -v "^${key}=" .hued > .hued.tmp || true
    printf '%s\n' "$line" >> .hued.tmp
    mv .hued.tmp .hued
  else
    printf "# https://github.com/orochi235/hued\n%s\n" "$line" > .hued
  fi
}

# Print the .hued line for one key, or an error and return 1. Validates without
# writing, so a multi-key `set` can check every value before touching the file.
_hued_key_line() {
  local key="$1" raw="$2" color line
  if _hued_is_policy_key "$key"; then
    raw=$(_hued_policy_value "hued set" "$key" "$raw") || return 1
    printf '%s=%s' "$key" "$raw"
    return
  fi
  if _hued_is_text_key "$key"; then
    # Parsers keep only the first token of a value.
    [[ "$raw" =~ ^[^[:space:]#]+$ ]] || {
      echo "hued set: '$raw' is not a valid ${key} value (one token, no spaces or #)" >&2
      return 1
    }
    printf '%s=%s' "$key" "$raw"
    return
  fi
  color="$(_hued_normalize_color "$raw")"
  line="${key}=${color}"
  # If the input was a recognized color name (not hex/none) that resolved to
  # #rrggbb, keep the original name as an inline comment for humans.
  local bare="${raw#\#}"
  if [[ ! "$bare" =~ ^[0-9a-fA-F]{3}$ && ! "$bare" =~ ^[0-9a-fA-F]{6}$ \
        && "$raw" != "none" && "$color" =~ ^#[0-9a-f]{6}$ ]]; then
    line="${line}  # ${raw}"
  fi
  printf '%s' "$line"
}

_hued_write_line() {
  local key="$1" line="$2" value
  _hued_put_line "$key" "$line"
  value="${line#*=}"
  echo "Set ${key} to ${value%%  #*} in ${PWD}/.hued"
}

_hued_set_key() {
  local line
  line=$(_hued_key_line "$1" "$2") || return 1
  _hued_write_line "$1" "$line"
}

_hued_resolve_hex() {
  local bare
  bare=$(_hued_name_key "${1#\#}")
  if [[ "$bare" =~ ^[0-9a-f]{6}$ ]]; then
    printf '%s' "$bare"
  elif [[ "$bare" =~ ^[0-9a-f]{3}$ ]]; then
    printf '%s' "${bare:0:1}${bare:0:1}${bare:1:1}${bare:1:1}${bare:2:1}${bare:2:1}"
  else
    local hex
    hex=$(_hued_lookup_name "$bare")
    printf '%s' "${hex#\#}"
  fi
}

# Print the nearest name for a bare rrggbb, or nothing if the list is missing.
_hued_nearest_name() {
  local hex="$1"
  [[ -f "$_HUED_NAMES_FILE" ]] || return 1
  python3 - "$hex" "$_HUED_NAMES_FILE" "${_HUED_XKCD:-0}" <<'PYEOF'
import re, sys

hexv, names_file, prefer_xkcd = sys.argv[1], sys.argv[2], sys.argv[3] == '1'

plain, override = {}, {}
with open(names_file) as f:
    for line in f:
        m = re.match(r'\s*\[(?:(xkcd):)?([^\]]+)\]=#([0-9a-f]{6})', line)
        if m:
            (override if m.group(1) else plain)[m.group(2)] = m.group(3)
if prefer_xkcd:
    plain.update(override)

target = tuple(int(hexv[i:i+2], 16) for i in (0, 2, 4))
best, best_d = '', None
for name, h in plain.items():
    c = tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
    d = sum((a - b) ** 2 for a, b in zip(c, target))
    if best_d is None or d < best_d:
        best, best_d = name, d
print(best)
PYEOF
}

# Emit OSC 10/11 escapes for the given bg/fg values to stdout.
# Empty value -> reset escape for that channel.
_hued_emit_osc() {
  local bg="$1" fg="$2" hex
  if [[ -n "$bg" ]]; then
    hex="$(_hued_resolve_hex "$bg")"
    [[ -n "$hex" ]] && printf '\e]11;rgb:%s/%s/%s\a' "${hex:0:2}" "${hex:2:2}" "${hex:4:2}"
  else
    printf '\e]111;\a'
  fi
  if [[ -n "$fg" ]]; then
    hex="$(_hued_resolve_hex "$fg")"
    [[ -n "$hex" ]] && printf '\e]10;rgb:%s/%s/%s\a' "${hex:0:2}" "${hex:2:2}" "${hex:4:2}"
  else
    printf '\e]110;\a'
  fi
}

# Repaint the terminal to match the nearest .hued (plus env overrides).
# Writes to ${HUED_TTY:-/dev/tty}; silent no-op if that cannot be opened.
_hued_apply_cmd() {
  local bg="" fg="" dir="$PWD"
  while [[ "$dir" != / && -n "$dir" ]]; do
    if [[ -f "$dir/.hued" ]]; then
      bg=$({ grep '^background=' "$dir/.hued" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}' | tr '[:upper:]' '[:lower:]')
      fg=$({ grep '^foreground=' "$dir/.hued" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}' | tr '[:upper:]' '[:lower:]')
      [[ -n "$bg" || -n "$fg" ]] && break
    fi
    dir="${dir%/*}"
  done

  if [[ -n "${HUED_BACKGROUND:-}" ]]; then
    bg=$(printf '%s' "$HUED_BACKGROUND" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi
  if [[ -n "${HUED_FOREGROUND:-}" ]]; then
    fg=$(printf '%s' "$HUED_FOREGROUND" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi
  [[ "$bg" == "none" ]] && bg=""
  [[ "$fg" == "none" ]] && fg=""

  local target="${HUED_TTY:-/dev/tty}"
  { exec 3>"$target"; } 2>/dev/null || return 0
  _hued_emit_osc "$bg" "$fg" >&3
  exec 3>&-
}

# A bare -n test would make HUED_LOOKUP_PREFER_XKCD=0 mean "on".
_HUED_XKCD=0
case "$(printf '%s' "${HUED_LOOKUP_PREFER_XKCD:-}" | tr '[:upper:]' '[:lower:]')" in
  ""|0|false|no|off|n) ;;
  *) _HUED_XKCD=1 ;;
esac
if [[ "${1:-}" == "-x" || "${1:-}" == "--xkcd" ]]; then
  _HUED_XKCD=1
  shift
fi

case "${1:-}" in
  "")
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    _hued_last_lines "$file" 'background|foreground'
    ;;

  -a|--all)
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    _hued_last_lines "$file" '[A-Za-z][A-Za-z0-9-]*'
    ;;

  -v|--version|version)
    echo "hued $HUED_VERSION"
    ;;

  where)
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    echo "$file"
    ;;

  apply)
    _hued_apply_cmd
    ;;

  resolve)
    [[ -z "${2:-}" ]] && { echo "Usage: hued resolve <color>" >&2; exit 1; }
    command -v pastel >/dev/null 2>&1 || {
      echo "hued resolve: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    pastel format hex "$2"
    ;;

  get)
    key=$(_hued_key "${2:-}") || {
      echo "Usage: hued get [${_HUED_KEY_LIST}] [--name]" >&2
      exit 1
    }
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    raw=$({ grep "^${key}=" "$file" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}')
    [[ -z "$raw" ]] && exit 1
    if _hued_is_policy_key "$key" || _hued_is_text_key "$key"; then
      [[ "${3:-}" == "--name" ]] && {
        echo "hued get: --name names a color; ${key} does not hold one" >&2
        exit 1
      }
      printf '%s\n' "$raw"
      exit 0
    fi
    # Ahead of the pastel check: reverse lookup is pure Python.
    if [[ "${3:-}" == "--name" ]]; then
      hex=$(_hued_resolve_hex "$raw")
      [[ -z "$hex" ]] && { echo "hued get: cannot resolve ${raw}" >&2; exit 1; }
      _hued_nearest_name "$hex"
      exit 0
    fi
    command -v pastel >/dev/null 2>&1 || {
      echo "hued get: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    pastel format hex "$raw"
    ;;

  mod|adjust)
    shift
    key="background"
    # With no channel given, an unknown leading token may have been meant as one.
    expected="expected bg|fg or one of: ${_HUED_OPS// /, }"
    case "${1:-}" in
      bg|background) key="background"; shift; expected="${_HUED_OPS// /, }" ;;
      fg|foreground) key="foreground"; shift; expected="${_HUED_OPS// /, }" ;;
    esac
    [[ $# -gt 0 ]] || { echo "Usage: hued mod [bg|fg] <op> [<args>...]" >&2; exit 1; }
    _hued_is_op "$1" || {
      echo "hued mod: unknown op '$1' ($expected)" >&2
      exit 1
    }
    command -v pastel >/dev/null 2>&1 || {
      echo "hued mod: requires 'pastel' (brew install pastel)" >&2
      exit 1
    }
    file=$(_hued_find) || { echo "No .hued file found" >&2; exit 1; }
    current=$({ grep "^${key}=" "$file" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}')
    [[ -z "$current" ]] && { echo "hued mod: ${key} not set in $file" >&2; exit 1; }
    new=$(_hued_mod_run "$current" "$@") || exit 1
    _hued_set_key "$key" "$new"
    _hued_apply_cmd
    ;;

  set)
    shift
    if [[ "${1:-}" == *=* ]] || { _hued_key "${1:-}" >/dev/null && [[ $# -gt 2 ]]; }; then
      # Several keys at once, as key=value tokens or key value pairs. Every
      # value is checked before anything is written.
      _pairs=()
      if [[ "$1" == *=* ]]; then
        for _tok in "$@"; do
          [[ "$_tok" == *=* ]] || { echo "hued set: '$_tok' is not key=value" >&2; exit 1; }
          _pairs+=("${_tok%%=*}" "${_tok#*=}")
        done
      else
        (( $# % 2 == 0 )) || { echo "hued set: '${!#}' has no value" >&2; exit 1; }
        _pairs=("$@")
      fi
      _keys=() _lines=()
      for (( _i = 0; _i < ${#_pairs[@]}; _i += 2 )); do
        key=$(_hued_key "${_pairs[_i]}") || {
          echo "hued set: unknown key '${_pairs[_i]}' (expected one of: ${_HUED_KEY_LIST//|/, })" >&2
          exit 1
        }
        [[ -n "${_pairs[_i+1]}" ]] || { echo "hued set: ${_pairs[_i]} has no value" >&2; exit 1; }
        _line=$(_hued_key_line "$key" "${_pairs[_i+1]}") || exit 1
        _keys+=("$key") _lines+=("$_line")
      done
      for _i in "${!_keys[@]}"; do _hued_write_line "${_keys[_i]}" "${_lines[_i]}"; done
    elif key=$(_hued_key "${1:-}"); then
      given="$1"; shift
      value="${1:-}"
      [[ -z "$value" ]] && { value="$(_hued_read_stdin_color)" || value=""; }
      [[ -z "$value" ]] && { echo "Usage: hued set ${given} <value>" >&2; exit 1; }
      _hued_set_key "$key" "$value" || exit 1
    elif [[ $# -gt 1 ]]; then
      # A bare `hued set <color>` is still a background, but a second argument
      # means the first was meant as a key — writing it as a color would
      # silently discard the value.
      echo "hued set: unknown key '$1' (expected one of: ${_HUED_KEY_LIST//|/, })" >&2
      exit 1
    else
      color="${1:-}"
      [[ -z "$color" ]] && { color="$(_hued_read_stdin_color)" || color=""; }
      [[ -z "$color" ]] && { echo "Usage: hued set [bg|fg] <color>" >&2; exit 1; }
      _hued_set_key "background" "$color"
    fi
    _hued_apply_cmd
    ;;

  fork)
    if [[ -f .hued ]]; then
      echo "hued fork: ${PWD}/.hued already exists" >&2
      exit 1
    fi
    ancestor=""
    dir="${PWD%/*}"
    while [[ "$dir" != / && -n "$dir" ]]; do
      if [[ -f "$dir/.hued" ]]; then
        ancestor="$dir/.hued"
        break
      fi
      dir="${dir%/*}"
    done
    [[ -z "$ancestor" && -f "/.hued" ]] && ancestor="/.hued"
    [[ -z "$ancestor" ]] && { echo "hued fork: no ancestor .hued to inherit from" >&2; exit 1; }
    bg=$({ grep '^background=' "$ancestor" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}')
    fg=$({ grep '^foreground=' "$ancestor" | tail -n1 || true; } | cut -d= -f2 | awk '{print $1}')
    if [[ -z "$bg" && -z "$fg" ]]; then
      echo "hued fork: ancestor $ancestor has no background or foreground to inherit" >&2
      exit 1
    fi
    if [[ -n "$bg" ]]; then _hued_set_key "background" "$bg"; fi
    if [[ -n "$fg" ]]; then _hued_set_key "foreground" "$fg"; fi
    _hued_apply_cmd
    ;;

  unset)
    key=$(_hued_key "${2:-}") || {
      echo "Usage: hued unset [${_HUED_KEY_LIST}]" >&2
      exit 1
    }
    [[ -f .hued ]] || { echo "hued unset: no .hued in ${PWD}" >&2; exit 1; }
    if ! grep -q "^${key}=" .hued; then
      echo "hued unset: ${key} not set in ${PWD}/.hued" >&2
      exit 1
    fi
    grep -v "^${key}=" .hued > .hued.tmp || true
    mv .hued.tmp .hued
    echo "Unset ${key} in ${PWD}/.hued"
    _hued_apply_cmd
    ;;

  pack)
    shift
    dir="."
    if [[ -n "${1:-}" && "$1" != -* ]]; then
      dir="$1"
      shift
    fi
    dir="$(cd "$dir" && pwd)"
    output=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -o) output="${2:-}"; shift 2 ;;
        *) echo "Usage: hued pack [<dir>] [-o <file>]" >&2; exit 1 ;;
      esac
    done
    result=$("$(dirname "$0")/hued-py" huedmap.files pack "$dir")
    if [[ -n "$output" ]]; then
      echo "$result" > "$output"
      echo "Wrote $(echo "$result" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))') entries to $output"
    else
      echo "$result"
    fi
    ;;

  unpack)
    [[ -z "${2:-}" ]] && { echo "Usage: hued unpack <file> [--force]" >&2; exit 1; }
    file="$2"
    force=0
    [[ "${3:-}" == "--force" ]] && force=1
    _xkcd_flag=""
    [[ "${_HUED_XKCD:-0}" == "1" ]] && _xkcd_flag="--xkcd"
    "$(dirname "$0")/hued-py" huedmap.files unpack "$file" "$force" ${_xkcd_flag:+"$_xkcd_flag"}
    _hued_apply_cmd
    ;;

  map|pick|-i|--interactive)
    # `pick` reports the colors instead of writing them; -i is the old picker's flag.
    _print_flag=""
    [[ "$1" == pick ]] && _print_flag="--print"
    shift
    _xkcd_flag=""
    [[ "${_HUED_XKCD:-0}" == "1" ]] && _xkcd_flag="--xkcd"
    exec "$(dirname "$0")/hued-py" huedmap --hued "$0" ${_print_flag:+"$_print_flag"} ${_xkcd_flag:+"$_xkcd_flag"} "$@"
    ;;

  *)
    echo "Usage: hued [-x] [-a | where | get <key> [--name] | set <key> <value> [<key> <value>...] | set <key>=<value>... | unset <key> | fork | mod [bg|fg] <op> [<args>...] | resolve <color> | pack [<dir>] [-o <file>] | unpack <file> [--force] | map [<dir>] [--no-open] | pick [<dir>] [--no-open] | -v]" >&2
    echo "       <key> is one of: ${_HUED_KEY_LIST//|/, }" >&2
    exit 1
    ;;
esac
